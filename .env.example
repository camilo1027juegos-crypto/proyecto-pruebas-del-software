# Copie este archivo como ".env" y ajuste los valores. El archivo ".env" NO se versiona.
# Lo que ya esté definido en el servidor (Apache SetEnv, panel de hosting) tiene prioridad.

# Entorno: "development" muestra errores en pantalla; cualquier otro valor los oculta.
APP_ENV=production
APP_BASE_URL=https://rubicam.co

# Base de datos MySQL/MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rubicam_db
DB_USER=root
DB_PASS=

# Alertas por n8n (el secreto firma las peticiones del panel hacia el webhook)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Ruta a un certificado CA propio (solo si el servidor no valida el SSL de n8n)
N8N_CA_BUNDLE=

# Chat «Rubi» del sitio público (webhook de n8n)
RUBI_WEBHOOK_URL=

# Carpeta de documentos del legajo: ruta absoluta, o relativa a la raíz del proyecto.
# Por defecto: uploads/
UPLOAD_DIR=
