{
    "name": "rubicam/redesign-panel",
    "description": "Landing y panel operativo de Órdenes de Operación (DO) de Agencia de Aduanas Rubicam S.A.S.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpmd/phpmd": "^2.15",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "suggest": {
        "ext-zip": "Permite validar por dentro los archivos .docx que se suben al legajo.",
        "ext-pcov": "Necesaria para medir cobertura de pruebas (composer test:cobertura)."
    },
    "autoload": {
        "psr-4": {
            "Rubicam\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rubicam\\Tests\\": "tests/",
            "Rubicam\\Herramientas\\": "tools/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "test:cobertura": "phpunit --colors=always --coverage-text",
        "lint": "phpcs",
        "lint:corregir": "phpcbf",
        "analizar": "phpmd src,config,handlers,panel/dashboard.php,panel/index.php,panel/logout.php,tools text phpmd.xml",
        "seguridad": "php tools/escanear_seguridad.php",
        "e2e": "php tests/e2e/ejecutar.php",
        "check": [
            "@lint",
            "@analizar",
            "@seguridad",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
