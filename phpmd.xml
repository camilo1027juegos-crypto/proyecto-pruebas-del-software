<?xml version="1.0"?>
<!--
  Analizador estático: PHP Mess Detector. Detecta complejidad ciclomática alta,
  código muerto, nombres poco descriptivos y malas prácticas de diseño.
  Ejecutar:  composer analizar
-->
<ruleset name="Rubicam PHPMD"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>Reglas de calidad del proyecto Rubicam (umbrales por defecto de PHPMD).</description>

    <!-- Complejidad ciclomática &gt; 10, NPath &gt; 200, métodos largos, clases grandes... -->
    <rule ref="rulesets/codesize.xml"/>

    <!-- Variables, parámetros, métodos y propiedades privadas sin usar. -->
    <rule ref="rulesets/unusedcode.xml"/>

    <!-- exit/eval/goto, jerarquías profundas, acoplamiento excesivo. -->
    <rule ref="rulesets/design.xml"/>

    <rule ref="rulesets/naming.xml">
        <exclude name="ShortVariable"/>
        <exclude name="ShortMethodName"/>
    </rule>
    <rule ref="rulesets/naming.xml/ShortVariable">
        <properties>
            <!-- $id y $e (excepción capturada) son convenciones universales. -->
            <property name="exceptions" value="id,e"/>
        </properties>
    </rule>
    <rule ref="rulesets/naming.xml/ShortMethodName">
        <properties>
            <!-- h() = escapar HTML: ayudante de vistas, como e() en otros frameworks. -->
            <property name="exceptions" value="h"/>
        </properties>
    </rule>

    <!--
      Limpieza de código. Se omite StaticAccess porque las fábricas estáticas del
      API de fechas de PHP (DateTimeImmutable::createFromFormat) son idiomáticas.
    -->
    <rule ref="rulesets/cleancode.xml">
        <exclude name="StaticAccess"/>
    </rule>
</ruleset>
